# ----------------------------------------------------------------------------
# Zenno mobile app environment configuration
#
# Copy this file to `.env` and adjust the values for your environment.
# `.env` is git-ignored so each developer can keep local overrides.
#
# Loaded at app startup via `flutter_dotenv`. Compile-time overrides via
# `--dart-define=API_BASE_URL=...` still take precedence so CI/release builds
# can inject production values without shipping a `.env` to the device.
# ----------------------------------------------------------------------------

# Backend base URL. Trailing `/api/v1` is optional - the app appends it if
# missing. The hosted backend is the default; switch to a local URL when
# running the NestJS server on your machine.
#
#   Hosted (default)  -> https://api.zenno.dev/api/v1
#   Android emulator  -> http://10.0.2.2:3000/api/v1   (host machine alias)
#   iOS simulator     -> http://localhost:3000/api/v1
#   Physical device   -> http://<your-LAN-IP>:3000/api/v1
API_BASE_URL=https://api.zenno.dev/api/v1

# `dev` enables verbose dio logging. Use `prod` for release builds.
ENV=dev
